ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000
# Set to true on Render/Railway (exactly one proxy in front): the client IP is the last X-Forwarded-For value.
# Leaving it false there makes every client share the proxy IP, so 5 rooms from anyone rate-limit everyone.
# Never true without a proxy, or behind two proxies (e.g. Cloudflare + Render): the limit becomes bypassable.
TRUST_PROXY=false
