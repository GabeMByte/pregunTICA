{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(*eval:questions*)",
      "Bash(*eval-questions*)",
      "PowerShell(*eval:questions*)",
      "PowerShell(*eval-questions*)",
      "Bash(*pnpm smoke*)",
      "Bash(*run smoke*)",
      "Bash(*scripts/smoke*)",
      "PowerShell(*pnpm smoke*)",
      "PowerShell(*run smoke*)",
      "PowerShell(*scripts/smoke*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-changed.sh"
          }
        ]
      }
    ]
  }
}
