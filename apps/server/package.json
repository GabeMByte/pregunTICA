{
  "name": "@preguntica/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:lan": "pnpm run dev",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "eval:questions": "tsx --env-file-if-exists=../../.env scripts/eval-questions.ts",
    "smoke": "tsx scripts/smoke.ts",
    "load": "tsx scripts/load.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@preguntica/shared": "workspace:*",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "socket.io-client": "^4.8.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
