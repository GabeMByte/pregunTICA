{
  "name": "pregunTICA",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @preguntica/server --filter @preguntica/web dev",
    "dev:lan": "pnpm --parallel --filter @preguntica/server --filter @preguntica/web dev:lan",
    "test": "pnpm -r --filter !@preguntica/e2e test",
    "test:e2e": "pnpm --filter @preguntica/e2e test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @preguntica/web build && pnpm --filter @preguntica/server build",
    "eval:questions": "pnpm --filter @preguntica/server eval:questions",
    "smoke": "pnpm --filter @preguntica/server smoke",
    "load": "pnpm --filter @preguntica/server load"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
